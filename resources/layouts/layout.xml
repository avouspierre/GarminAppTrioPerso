<layout id="WatchFace">
    <drawable class="Background" />
    
    <!-- IOB on the left -->
    <label id="IOBLabel" text="10.5U" x="5%" y="33%" font="Gfx.FONT_MEDIUM" color="Graphics.COLOR_BLUE" justification="Graphics.TEXT_JUSTIFY_LEFT|Gfx.TEXT_JUSTIFY_VCENTER" />
    

    <!-- Bitmap icons - positioned manually in code but must be defined here -->
    <bitmap id="ISFIcon" filename="../drawables/UpDown.svg" scaleX="8%" scaleY="8%" x="40%" y="30%" scaleRelativeTo="screen">
        <palette>
            <color>00FF00</color>
        </palette>
    </bitmap>
    <label id="COBLabel" text="48" x="63%" y="33%" font="Gfx.FONT_MEDIUM" color="Graphics.COLOR_GREEN" justification="Graphics.TEXT_JUSTIFY_CENTER|Gfx.TEXT_JUSTIFY_VCENTER" />

    <drawable id="line1" />

    <!-- Heart Rate and Steps - still using layout positions -->
    <drawable id="HeartRate" />
    <label id="HRLabel" text="73" x="30%" y="72%" font="Gfx.FONT_TINY" color="Graphics.COLOR_LT_GRAY" justification="Graphics.TEXT_JUSTIFY_LEFT|Gfx.TEXT_JUSTIFY_VCENTER" />
    
    <drawable id="StepsIcon" />
    <label id="StepsLabel" text="--" x="58%" y="72%" font="Gfx.FONT_TINY" color="Graphics.COLOR_LT_GRAY" justification="Graphics.TEXT_JUSTIFY_LEFT|Gfx.TEXT_JUSTIFY_VCENTER" />

    <!-- Date -->
    <text-area id="DateLabel" width="fill" height="20%" x="center" y="80%" font="Graphics.FONT_GLANCE" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />

</layout>